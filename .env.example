# Authentication token for legacy single-account callers.
# Generate with: openssl rand -hex 32
BRIDGE_API_TOKEN=change-me

# WeChat Official Account credentials. Keep these only on the server that runs this bridge.
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=your_app_secret

# Optional: protect WeChat callback URL verification if you enable callbacks.
WECHAT_CALLBACK_TOKEN=

# Multi-tenant storage and administration. Generate each secret independently.
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
WECHAT_BRIDGE_CREDENTIAL_ENCRYPTION_KEY=
WECHAT_BRIDGE_API_KEY_PEPPER=
WECHAT_BRIDGE_ADMIN_SESSION_SECRET=
WECHAT_BRIDGE_ADMIN_INITIAL_USERNAME=admin
# Used only to create the first administrator, then remove it from .env.
WECHAT_BRIDGE_ADMIN_INITIAL_PASSWORD=
WECHAT_BRIDGE_ADMIN_SESSION_TTL_SECONDS=28800
WECHAT_BRIDGE_AUDIT_LOG_RETENTION_COUNT=10000
WECHAT_BRIDGE_DATABASE_PATH=/data/wechat-account-bridge.sqlite3

# Runtime
# Optional public HTTPS base URL for bridge-backed client scripts.
WECHAT_BRIDGE_BASE_URL=
WECHAT_BRIDGE_ROOT_PATH=
WECHAT_BRIDGE_HOST=0.0.0.0
WECHAT_BRIDGE_PORT=8080
WECHAT_BRIDGE_TEMP_DIR=/tmp/wechat-account-bridge
WECHAT_BRIDGE_UPLOAD_TTL_SECONDS=1800
WECHAT_BRIDGE_KEEP_FAILED_UPLOADS=false
WECHAT_BRIDGE_LOG_LEVEL=INFO
WECHAT_BRIDGE_ENABLE_DOCS=false
